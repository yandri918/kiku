# Application
DATABASE_URL=postgresql://user:password@localhost:5432/kikulog
SECRET_KEY=change-this-to-a-random-secret-key

# Model / Tinker
TINKER_API_KEY=your-tinker-api-key
TINKER_MODEL_ID=your-model-id-after-training
TINKER_ENDPOINT=https://api.thinkingmachines.ai/tinker/v1

# Inference timeout (seconds)
MODEL_TIMEOUT_SECONDS=30

# Demo mode (true = synthetic data only, write access rate-limited)
DEMO_MODE=false

# Rate limiting (requests per minute per IP in demo mode)
DEMO_RATE_LIMIT=20

# Timezone for operational dates
WORK_TIMEZONE=Asia/Tokyo

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
